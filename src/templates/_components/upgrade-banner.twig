<div class="lens-upgrade-banner">
    <div class="lens-upgrade-banner__content">
        <div class="lens-upgrade-banner__icon">
            {{ svg(craft.app.plugins.getPlugin('lens').basePath ~ '/icon.svg')|attr({width: 36, height: 36}) }}
        </div>
        <div class="lens-upgrade-banner__text">
            <h2 class="lens-section-header__title">{{ 'Unlock the full power of Lens'|t('lens') }}</h2>
            <p class="lens-upgrade-banner__subtitle">{{ 'Everything in Lite, plus:'|t('lens') }}</p>
        </div>
    </div>
    <ul class="lens-upgrade-banner__features">
        <li>{{ "Search the asset library and every asset picker by image content. Long descriptions, tags, and OCR'd text are indexed in every site language and ranked by relevance."|t('lens') }}</li>
        <li>{{ "Long descriptions, 35+ semantic tags, and OCR text on every image, all fed into the search index and filterable from Craft's asset sources."|t('lens') }}</li>
        <li>{{ 'Analyze entire volumes in one click, with live progress, live cost estimate, and retry on failures.'|t('lens') }}</li>
        <li>{{ 'Duplicate and near-duplicate detection across your library, plus on-demand "find similar" for any asset.'|t('lens') }}</li>
        <li>{{ 'Know what the analysis costs you: by provider, by asset, by month.'|t('lens') }}</li>
    </ul>
    <a href="https://plugins.craftcms.com/lens" class="btn submit" target="_blank">
        {{ 'Upgrade to Pro'|t('lens') }}
    </a>
</div>
